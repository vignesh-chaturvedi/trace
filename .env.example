# Copy to `.env` and paste your key. `.env` is gitignored; this file is not.
#
#   cp .env.example .env
#
# Set ONLY the variable for the provider you are using, and make sure
# `model.api_key_env` in trace.toml names that same variable.
#
# A real environment variable always beats this file, so CI secrets are never
# clobbered by a stale local copy.
#
# NOT needed for: cargo test, trace replay, trace lint, trace inspect, or any
# run with --fixture. Only a live `trace run` or `trace bench run` spends money.

OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# The key and the endpoint are set independently, and they must agree.
#
# Pointing base_url at one vendor while supplying another vendor's key sends
# that credential to a party you did not intend. It fails with a 401 -- after
# the key has already left the machine. Change both together.
#
# OpenAI (default):
#   base_url    = "https://api.openai.com/v1"
#   api_key_env = "OPENAI_API_KEY"
#   stream_usage = true
#
# Gemini, via its OpenAI-compatible endpoint (verify the URL against Google's
# current docs -- it has moved before):
#   base_url    = "https://generativelanguage.googleapis.com/v1beta/openai"
#   api_key_env = "GEMINI_API_KEY"
#   stream_usage = false        # compat layers often reject stream_options
#   requests_per_minute = 15    # pace to the free tier instead of eating 429s
#
# Self-hosted vLLM (Phase 4):
#   base_url    = "http://localhost:8000/v1"
#   api_key_env = "VLLM_API_KEY"
